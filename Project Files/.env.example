# IMovies environment variables

# MongoDB connection string — used by the Express backend (server/index.js).
# Local:   mongodb://127.0.0.1:27017/imovies
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imovies
MONGO_URI=mongodb://127.0.0.1:27017/imovies

# Backend port (optional, defaults to 5000)
PORT=5000
